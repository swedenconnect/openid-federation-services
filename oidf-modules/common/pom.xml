<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>se.swedenconnect.oidf</groupId>
        <artifactId>oidf-modules</artifactId>
        <version>0.11.17-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <packaging>jar</packaging>

    <name>OIDF :: Modules :: Common</name>
    <description>Shared building blocks for the OpenID Federation Services: entity and registry
        records, record sources, caches, the federation tree and entity statement signing</description>
    <url>https://docs.swedenconnect.se/openid-federation-services</url>

    <!--
      Built for Java 21, unlike the rest of the reactor, which targets 25. This module is the one
      that is consumed on its own, so keeping its bytecode at 21 lets projects that have not moved
      past Java 21 depend on it. The build itself still runs on JDK 25.
    -->
    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.15.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
